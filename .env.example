# Copie para .env e preencha. Nunca commite o .env.

# OpenRouter (crie a chave em https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ordem de fallback; openrouter/free fica por último
LLM_MODELS=nvidia/nemotron-3.5-lightning:free,z-ai/glm-5.2:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# Banco de dados
DB_BACKEND=sqlite
DB_PATH=data/cinerocket.db
QUERY_TIMEOUT_SECONDS=30
MAX_ROWS=200

# Agente
MAX_LLM_CALLS_PER_QUESTION=3
CACHE_DIR=.cache
# Data de referência para "últimos N anos" (AAAA-MM-DD); vazio = hoje
REFERENCE_DATE=
LOG_LEVEL=INFO

# Databricks (opcional, DB_BACKEND=databricks)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
