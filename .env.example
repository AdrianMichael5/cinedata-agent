# Copie para .env e preencha. Nunca commite o .env.

# OpenRouter (crie a chave em https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ordem de fallback (do mais rápido ao mais lento num teste A/B real; openrouter/free por último)
LLM_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# Banco de dados
DB_BACKEND=sqlite
DB_PATH=data/cinerocket.db
# Pares ator-diretor levam ~55 s no banco real; 60 s deixava pouca folga.
QUERY_TIMEOUT_SECONDS=120
MAX_ROWS=200

# Agente
MAX_LLM_CALLS_PER_QUESTION=3
# Teto de requisições ao OpenRouter por pergunta, somando as tentativas de fallback entre modelos
MAX_REQUESTS_PER_QUESTION=6
# Teto de tokens de saída por chamada ao modelo (evita resposta degenerada até o limite do provedor)
MAX_OUTPUT_TOKENS=2000
# Esforço de raciocínio enviado ao modelo (extra_body.reasoning.effort); vazio = não envia
LLM_REASONING_EFFORT=low
CACHE_DIR=.cache
# Uma linha JSON por requisição ao OpenRouter (sem chave e sem prompt); veja: cinedata requests --today
REQUEST_LOG_PATH=logs/requests.jsonl
# Data de referência para "últimos N anos" (AAAA-MM-DD); vazio = hoje
REFERENCE_DATE=
LOG_LEVEL=INFO

# Databricks (opcional, DB_BACKEND=databricks)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
